rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'captainmarkvil@gmail.com';
    }
    
    function isCellLeaderAdmin() {
      return isSuperAdmin() || (request.auth != null && request.auth.token.email == 'isalynmaravilla13@gmail.com');
    }

    function isEventAdmin() {
      return isSuperAdmin() || (request.auth != null && (request.auth.token.email == 'beaangelnicole.mendoza@gmail.com' || request.auth.token.email == 'beaangelnicole.mendoza@gmail.con'));
    }

    function isPrayerAdmin() {
      return isSuperAdmin() || (request.auth != null && request.auth.token.email == 'lzvmndmendoza@gmail.com');
    }

    // Allow super admin to access everything
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /bible_progress/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /scripture_reflections/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /hundred_days_reflections/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /conversations/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /prayer_requests/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /visits/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /cell_groups/{groupId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (isCellLeaderAdmin() || request.auth.uid == resource.data.leaderId || request.auth.uid == resource.data.createdByUid);
    }
    
    match /leader_tools/{document=**} {
      allow read: if true;
      allow write: if isCellLeaderAdmin();
    }

    match /cell_leader_tools/weekly_memory_verse {
      allow read: if true;
      allow create, delete: if isCellLeaderAdmin();
      allow update: if isCellLeaderAdmin() || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memorizedUserIds']));
    }

    match /cell_leader_tools/{document=**} {
      allow read: if true;
      allow write: if isCellLeaderAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isEventAdmin();
      
      match /rsvps/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /prayer_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isPrayerAdmin();
    }

    match /prayer_logs/{logId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /prayer_counters/{counterId} {
      allow read, write: if true;
    }
    
    match /fasting_commitments/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
