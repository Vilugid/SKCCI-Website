# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Used on the server-side only in server.ts to power the Hannah AI Church Assistant.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Client-Side Role Configuration (comma-separated email lists)
# VITE_SUPER_ADMIN_EMAILS="admin@example.com"
# VITE_CELL_ADMIN_EMAILS="celladmin@example.com"
# VITE_EVENT_ADMIN_EMAILS="eventadmin@example.com"
# VITE_PRAYER_ADMIN_EMAILS="prayeradmin@example.com"

